        <div id="project-image">
            <img />
        </div>
        <div id="project-content">
            <h1 class="project-title">Projeto</h1>
            <p class="project-description">Descrição de projeto.</p>
        </div>
        <div id="project-footer">
            <div class="project-badges-container">
